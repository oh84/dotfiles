#!/usr/bin/env bash
#MISE description="宣言的な設定に収まらないセットアップ（mise bootstrapの最終ステップで実行される）"

set -eu

# ==============================================================================
# Homebrew
# ==============================================================================

if ! command -v brew &>/dev/null; then
	# https://docs.brew.sh/Installation
	echo "Homebrew is not installed, installing..."
	NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

	# インストール直後はまだPATHに入っていない
	if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
		eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
	elif [[ -x /opt/homebrew/bin/brew ]]; then
		eval "$(/opt/homebrew/bin/brew shellenv)"
	fi
fi

brew bundle --global # from $HOME/.Brewfile
# brew bundle --file "$HOME/.Brewfile.cask"
# brew bundle --file "$HOME/.Brewfile.mas"

# ==============================================================================
# vim-plug
# ==============================================================================

if [[ ! -d "$HOME/.vim/plugged" ]]; then
	mkdir -p "$HOME/.vim/plugged"
	curl -fLo "$HOME/.vim/autoload/plug.vim" --create-dirs https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
fi

# ==============================================================================
# tmux
# ==============================================================================

# For tmux-logging
mkdir -p "$HOME/logs/tmux"

# ==============================================================================
# git hooks
# ==============================================================================

# core.hooksPathの設定下でも、グローバルフック（~/.config/git/hooks/pre-commit）が
# .git/hooks/pre-commitへ連鎖してくれるため、ここで生成したフックが有効になる
mise generate git-pre-commit --write --task=pre-commit
