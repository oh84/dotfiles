{
  "title": "frontmost-app-if-remote-desktop-apps",
  "rules": [
    {
      "description": "最前面アプリがリモートデスクトップアプリのとき、 caps lock を right control に割り当てつつ、空打ちの場合は IMEオン・オフ をトグルで切り替える (alt + ~ を送信する)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.microsoft\\.rdc\\.macos$",
                "^com\\.google\\.Chrome\\.app\\.efmjfjelnicpmdcmfikempdhlmainjcb$",
                "^com\\.omnissa\\.horizon\\.client.mac$",
                "^com\\.splashtop\\.stb\\.macosx$"
              ]
            }
          ],
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 250,
            "basic.to_if_held_down_threshold_milliseconds": 250
          },
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "right_control",
              "lazy": true
            }
          ],
          "to_if_held_down": [
            {
              "key_code": "right_control"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "grave_accent_and_tilde",
              "modifiers": [
                "left_option"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "最前面アプリがリモートデスクトップアプリのとき、control と command を入れ替える",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.microsoft\\.rdc\\.macos$",
                "^com\\.google\\.Chrome\\.app\\.efmjfjelnicpmdcmfikempdhlmainjcb$",
                "^com\\.omnissa\\.horizon\\.client.mac$",
                "^com\\.splashtop\\.stb\\.macosx$"
              ]
            }
          ],
          "from": {
            "key_code": "left_control"
          },
          "to": {
            "key_code": "left_command"
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.microsoft\\.rdc\\.macos$",
                "^com\\.google\\.Chrome\\.app\\.efmjfjelnicpmdcmfikempdhlmainjcb$",
                "^com\\.omnissa\\.horizon\\.client.mac$",
                "^com\\.splashtop\\.stb\\.macosx$"
              ]
            }
          ],
          "from": {
            "key_code": "left_command"
          },
          "to": {
            "key_code": "left_control"
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.microsoft\\.rdc\\.macos$",
                "^com\\.google\\.Chrome\\.app\\.efmjfjelnicpmdcmfikempdhlmainjcb$",
                "^com\\.omnissa\\.horizon\\.client.mac$",
                "^com\\.splashtop\\.stb\\.macosx$"
              ]
            }
          ],
          "from": {
            "key_code": "right_control"
          },
          "to": {
            "key_code": "right_command"
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.microsoft\\.rdc\\.macos$",
                "^com\\.google\\.Chrome\\.app\\.efmjfjelnicpmdcmfikempdhlmainjcb$",
                "^com\\.omnissa\\.horizon\\.client.mac$",
                "^com\\.splashtop\\.stb\\.macosx$"
              ]
            }
          ],
          "from": {
            "key_code": "right_command"
          },
          "to": {
            "key_code": "right_control"
          }
        }
      ]
    },
    {
      "description": "最前面アプリがリモートデスクトップアプリのとき、 right control + [ を esc に割り当てる",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.microsoft\\.rdc\\.macos$",
                "^com\\.google\\.Chrome\\.app\\.efmjfjelnicpmdcmfikempdhlmainjcb$",
                "^com\\.omnissa\\.horizon\\.client.mac$",
                "^com\\.splashtop\\.stb\\.macosx$"
              ]
            }
          ],
          "from": {
            "key_code": "close_bracket", // Karabiner-EventViewer で [ キーが close_bracket と認識されるため
            "modifiers": {
              "mandatory": [
                "right_control"
              ]
            }
          },
          "to": [
            {
              "key_code": "escape"
            }
          ]
        }
      ]
    }
  ]
}
