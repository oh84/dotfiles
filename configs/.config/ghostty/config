# command = zsh -c "tmux new -A -s default"

window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

background-opacity = 1.0
background-blur-radius = 0

font-size = 15
font-family = UDEV Gothic NF
font-feature = -dlig

shell-integration-features = no-cursor
cursor-style = block

keybind = shift+enter=text:\x1b\r
